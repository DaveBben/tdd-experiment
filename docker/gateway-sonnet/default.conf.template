# The only route out of the Sonnet agent network: the Anthropic API, with the key added here
# so no session container ever holds it. DNS is re-resolved, so an upstream IP change cannot break it.
server {
    listen 8080;
    client_max_body_size 0;
    resolver 127.0.0.11 valid=300s ipv6=off;
    set $upstream https://api.anthropic.com;
    location /v1/ {
        proxy_pass $upstream;
        proxy_ssl_server_name on;
        proxy_set_header Host api.anthropic.com;
        proxy_set_header x-api-key ${ANTHROPIC_API_KEY};
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
    }
}
