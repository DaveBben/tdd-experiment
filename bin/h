#!/bin/sh
# Run a harness command inside the pinned harness image, e.g. `bin/h pytest -q tests`.
set -e
cd "$(dirname "$0")/.."
docker build -q -f docker/harness.Dockerfile -t tdd-harness . >/dev/null
exec docker run --rm -i -v "$PWD:/work" -v /var/run/docker.sock:/var/run/docker.sock \
  --env-file .env tdd-harness "$@"
